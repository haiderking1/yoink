{
  "manifest_version": 3,
  "name": "Yoink",
  "version": "0.2.0",
  "description": "Sends your downloads to Yoink (aria2) instead of the browser's downloader.",
  "key": "",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["downloads", "nativeMessaging", "cookies", "contextMenus", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Yoink",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": false },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
